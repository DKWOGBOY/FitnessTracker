# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# CalorieAPI key (free tier available): https://calorieapi.com
# Deliberately NOT VITE_-prefixed - it's read server-side only, by
# netlify/functions/calorieapi.mts (CalorieAPI doesn't support being called
# directly from browser JS - no Access-Control-Allow-Origin on its
# responses - so this app proxies it through a Netlify Function instead).
CALORIEAPI_KEY=your-calorieapi-key

# LIFT gym app - separate Supabase project, read-only exercise data.
# See lift-integration/lift_sessions_view.sql - must be applied to LIFT's
# project (not this one) before this works. Omit these two vars entirely
# to disable the Exercise card.
VITE_LIFT_SUPABASE_URL=https://your-lift-project-ref.supabase.co
VITE_LIFT_SUPABASE_ANON_KEY=your-lift-anon-key
